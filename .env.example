# 飞书自建应用凭证（飞书开放平台 → 凭证与基础信息里拿）
# ⚠️ 这个文件已加入 .gitignore，绝对不要 commit！
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 要读取的 wiki/飞书多维表格的 spreadsheet_token 和 sheet_id
# 你给的链接：https://my.feishu.cn/wiki/K6YDwZGP8im24Ek5WnecdJH5nrd?sheet=4e7337
DEFAULT_SPREADSHEET_TOKEN=K6YDwZGP8im24Ek5WnecdJH5nrd
DEFAULT_SHEET_ID=4e7337

# CORS 允许的跨域源（生产建议写具体域名，多个用逗号分隔；开发 * 也可）
CORS_ORIGINS=*

# 飞书返回值缓存时间（秒），防止你们两人同时开页面狂刷打到飞书限流
CACHE_TTL_SEC=600
